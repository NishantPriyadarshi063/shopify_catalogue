{
  "name": "tiltingheads-catalogue",
  "version": "1.0.0",
  "private": true,
  "description": "Postgres-backed Shopify catalogue (brand-wise backfill)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "backfill": "node scripts/backfill.js",
    "backfill:th": "node scripts/backfill.js --brand=tiltingheads",
    "backfill:all": "node scripts/backfill.js --all"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pg": "^8.22.0"
  }
}
