# Server
PORT=5050
NODE_ENV=development

# Postgres (schema=shopify is applied via search_path)
DATABASE_URL=postgresql://user:pass@host:5432/dbname?schema=shopify&sslmode=require

# Shopify API
SHOPIFY_API_VERSION=2025-01
CATALOGUE_DEFAULT_BRAND=tiltingheads

# Auto backfill (in-process cron)
CATALOGUE_BACKFILL_ENABLED=true
CATALOGUE_BACKFILL_INTERVAL_MIN=30
CATALOGUE_BACKFILL_ON_BOOT=true
CATALOGUE_BACKFILL_BOOT_DELAY_SEC=10
# Optional: tiltingheads,billicompany — empty = all configured brands
# CATALOGUE_BACKFILL_BRANDS=

# Per brand:
# SHOPIFY_{SLUG}_SHOP_DOMAIN=
# SHOPIFY_{SLUG}_ACCESS_TOKEN=shpca_... or shpat_...
# SHOPIFY_{SLUG}_BRAND_ID=   (optional; defaults: TH=20, Billy=21, Mannmore=22, Urthend=23, Sniff=24)

SHOPIFY_TILTINGHEADS_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_TILTINGHEADS_ACCESS_TOKEN=
SHOPIFY_TILTINGHEADS_BRAND_ID=20
